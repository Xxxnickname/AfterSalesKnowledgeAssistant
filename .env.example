# 服务
APP_NAME=设备售后智能客服
APP_ENV=dev
APP_PORT=8001
APP_SECRET=change-me-to-a-long-random-string
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# 数据库 / 缓存 / 图谱（Compose 内部网络）
DATABASE_URL=postgresql+psycopg://kb:kbpass@db:5432/kb
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpass

# 模型（OpenAI 兼容；未配置时使用检索式降级回答）
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=deepseek-flash

# 业务参数
EMBEDDING_DIM=384
SESSION_TTL_MIN=30
KB_MIN_SCORE=0.30
RATE_LIMIT_PER_MIN=20
MAX_CONCURRENT=5
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@12345
SEED_DEMO=true
DEMO_MODE=true
DEFAULT_TENANT=t_demo

APP_BIND=127.0.0.1
NEO4J_BIND=127.0.0.1
TENANT_NAME=恒锐精工演示租户
HEARTBEAT_TIMEOUT_SEC=60
