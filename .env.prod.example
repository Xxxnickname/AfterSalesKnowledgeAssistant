# 生产环境模板。复制为 .env.prod 后填写，不要提交到版本库。
# PowerShell: Copy-Item .env.prod.example .env.prod
APP_NAME=设备售后知识客服
APP_ENV=prod
APP_PORT=8001
APP_BIND=127.0.0.1
ALLOW_PUBLIC_BIND=false
APP_ENV_FILE=.env.prod
APP_SECRET=__GENERATE_AT_LEAST_32_RANDOM_CHARS__
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# PostgreSQL（密码同时写入 DATABASE_URL；建议使用 URL 安全字符）
POSTGRES_DB=kb
POSTGRES_USER=kb
POSTGRES_PASSWORD=__CHANGE_ME_DB_PASSWORD__
DATABASE_URL=postgresql+psycopg://kb:__CHANGE_ME_DB_PASSWORD__@db:5432/kb
REDIS_URL=redis://redis:6379/0

# Neo4j；生产只绑定回环地址；密码建议使用 URL 安全字符
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__CHANGE_ME_NEO4J_PASSWORD__
NEO4J_BIND=127.0.0.1

# 模型（OpenAI 兼容）；留空时使用检索式降级回答
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=deepseek-flash

EMBEDDING_DIM=384
SESSION_TTL_MIN=30
KB_MIN_SCORE=0.30
RATE_LIMIT_PER_MIN=20
MAX_CONCURRENT=5
HEARTBEAT_TIMEOUT_SEC=60

# 首个管理员；生产不导入演示数据
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=__CHANGE_ME_ADMIN_PASSWORD__
SEED_DEMO=false
DEMO_MODE=false
DEFAULT_TENANT=t_prod
TENANT_NAME=设备售后知识库
